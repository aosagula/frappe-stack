# Un archivo por cliente en el VPS: $DEPLOY_ROOT/<cliente>/.env
# FRAPPE_IMAGE lo actualiza deploy-client.sh en cada release; no editar a mano.
COMPOSE_PROJECT_NAME=frappe-demo
FRAPPE_IMAGE=ghcr.io/aosagula/frappe-demo:CAMBIAR
SITE_NAME=demo.agentic4biz.com
FRONTEND_ALIAS=frappe-demo-frontend
PROXY_NETWORK=reverse-proxy

# Clientes nuevos: 11.8. Instancias existentes en 10.6: dejar 10.6 hasta planificar el upgrade de MariaDB.
MARIADB_IMAGE=mariadb:11.8

DB_ROOT_PASSWORD=change-me-root
ADMIN_PASSWORD=change-me-admin

DEVELOPER_MODE=0
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
