map $http_x_forwarded_proto $frappe_forwarded_proto {
	default $http_x_forwarded_proto;
	"" $scheme;
}

# El servidor de realtime de Frappe exige el header Origin y lo usa para armar la URL.
# Algunos requests de polling same-origin no lo traen; antes lo parcheabamos en el fork
# de Frappe (realtime/utils.js). Ahora lo completamos aca y el core queda oficial.
map $http_origin $frappe_origin {
	default $http_origin;
	"" "$frappe_forwarded_proto://${SITE_NAME}";
}

server {
	listen 8080;

	# DNS interno de Docker con variables en proxy_pass: si websocket o backend se reinician,
	# nginx sigue arriba y vuelve a resolverlos (sin esto, nginx no arranca si falta un upstream).
	resolver 127.0.0.11 valid=10s ipv6=off;
	set $frappe_backend http://backend:8000;
	set $frappe_websocket http://websocket:9000;
	server_name ${SITE_NAME};

	client_max_body_size ${CLIENT_MAX_BODY_SIZE};

	root /home/frappe/frappe-bench/sites;

	proxy_buffer_size 128k;
	proxy_buffers 4 256k;
	proxy_busy_buffers_size 256k;

	location /assets {
		try_files $uri =404;
		add_header Cache-Control "public, max-age=31536000, immutable";
	}

	location /files {
		try_files /${SITE_NAME}/public$uri @backend;
	}

	location /private/files {
		internal;
		try_files /${SITE_NAME}/private$uri =404;
	}

	location /socket.io {
		proxy_http_version 1.1;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection "upgrade";
		proxy_set_header X-Frappe-Site-Name ${SITE_NAME};
		proxy_set_header Host ${SITE_NAME};
		proxy_set_header X-Forwarded-Host ${SITE_NAME};
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $frappe_forwarded_proto;
		proxy_set_header Origin $frappe_origin;
		proxy_pass $frappe_websocket;
	}

	location / {
		try_files /${SITE_NAME}/public/$uri @backend;
	}

	location @backend {
		proxy_set_header X-Frappe-Site-Name ${SITE_NAME};
		proxy_set_header Host ${SITE_NAME};
		proxy_set_header X-Forwarded-Host ${SITE_NAME};
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $frappe_forwarded_proto;
		proxy_read_timeout 120;
		proxy_redirect off;
		proxy_pass $frappe_backend;
	}
}
